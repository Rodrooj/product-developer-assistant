# Copie este arquivo para plow-credentials e defina permissão 0600:
#   cp plow-credentials.example plow-credentials
#   chmod 600 plow-credentials
# Obtenha seu token usando:
#   plow-agents login --new-line
#   plow-agents mint <line-uid>
