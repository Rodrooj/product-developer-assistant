# ==============================================================================
# Product Developer Assistant - Environment Configuration Template
# ==============================================================================
# Copie este arquivo para .env e preencha com suas credenciais:
#   cp .env.example .env
# NUNCA envie seu arquivo .env com credenciais reais para o controle de versão!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Credenciais de E-mail (IMAP) - Email Reader Skill
# ------------------------------------------------------------------------------
# Suporte nativo multi-conta para Gmail, iCloud e Outlook.
# Para Gmail e iCloud, utilize Senhas de Aplicativo (App-Specific Passwords).

# Conta Gmail
PLOW_IMAP_GMAIL_HOST=imap.gmail.com
PLOW_IMAP_GMAIL_PORT=993
PLOW_IMAP_GMAIL_USERNAME=seu_usuario@gmail.com
PLOW_IMAP_GMAIL_PASSWORD=sua_senha_de_app_gmail

# Conta iCloud
PLOW_IMAP_ICLOUD_HOST=imap.mail.me.com
PLOW_IMAP_ICLOUD_PORT=993
PLOW_IMAP_ICLOUD_USERNAME=seu_usuario@icloud.com
PLOW_IMAP_ICLOUD_PASSWORD=sua_senha_de_app_icloud

# Conta Outlook / Office 365 (Opcional)
PLOW_IMAP_OUTLOOK_HOST=outlook.office365.com
PLOW_IMAP_OUTLOOK_PORT=993
PLOW_IMAP_OUTLOOK_USERNAME=seu_usuario@outlook.com
PLOW_IMAP_OUTLOOK_PASSWORD=sua_senha_outlook

# Conta padrão (usada quando nenhum --account é fornecido)
PLOW_IMAP_HOST=imap.gmail.com
PLOW_IMAP_PORT=993
PLOW_IMAP_USERNAME=seu_usuario@gmail.com
PLOW_IMAP_PASSWORD=sua_senha_de_app_gmail

# ------------------------------------------------------------------------------
# 2. Token do GitHub - GitHub Ops Skill
# ------------------------------------------------------------------------------
# Token de acesso pessoal (Classic ou Fine-grained) com escopos: repo, read:org, workflow
GH_TOKEN=gho_seu_token_github_aqui
GITHUB_TOKEN=gho_seu_token_github_aqui
