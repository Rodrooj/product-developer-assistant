# Build context for your private FoxMCP checkout. Default assumes both repos
# are sibling directories (product-developer-assistant/ and FoxMCP/).
FOX_MCP_SOURCE_PATH=../FoxMCP
HERMES_BASE_IMAGE=nousresearch/hermes-agent:latest
HERMES_UID=
HERMES_GID=
API_SERVER_KEY=

# Local model. The pull script checks disk space before downloading.
LOCAL_MODEL=qwen3:4b
OLLAMA_CONTEXT_LENGTH=65536
OLLAMA_KEEP_ALIVE=24h
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_API_KEY=ollama

# Hermes dashboard/API is bound to localhost only by default.
HERMES_PORT=8642

# Optional GitHub CLI token; use a least-privilege fine-grained token.
GH_TOKEN=
GITHUB_TOKEN=

# IMAP. The bridge accepts EMAIL_IMAP_* and legacy PLOW_IMAP_* names.
EMAIL_IMAP_GMAIL_HOST=imap.gmail.com
EMAIL_IMAP_GMAIL_PORT=993
EMAIL_IMAP_GMAIL_USERNAME=
EMAIL_IMAP_GMAIL_PASSWORD=

EMAIL_IMAP_ICLOUD_HOST=imap.mail.me.com
EMAIL_IMAP_ICLOUD_PORT=993
EMAIL_IMAP_ICLOUD_USERNAME=
EMAIL_IMAP_ICLOUD_PASSWORD=

EMAIL_IMAP_OUTLOOK_HOST=outlook.office365.com
EMAIL_IMAP_OUTLOOK_PORT=993
EMAIL_IMAP_OUTLOOK_USERNAME=
EMAIL_IMAP_OUTLOOK_PASSWORD=

# Do not set FOXMCP_AUTO_APPROVE=1. The compose file forces it to 0.
